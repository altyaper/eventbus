# Copy to .env (docker compose reads .env automatically) and fill in
# before running `docker compose up`.

# Must be 64+ bytes. Generate with: openssl rand -base64 64 | tr -d "\n"
# (or mix phx.gen.secret)
SECRET_KEY_BASE=

# Hostname/IP you'll reach the app at on your LAN (e.g. raspberrypi.local or 192.168.1.50)
PHX_HOST=raspberrypi.local

# Optional: other hosts you open the UI at, comma-separated
# (e.g. eventbus.example.com,192.168.1.50). Live updates fail on any host not
# listed here or in PHX_HOST.
PHX_EXTRA_ORIGINS=

# Shared secret required to POST events to /api/topics/:name/events
EVENTBUS_API_KEY=change-me

POSTGRES_USER=eventbus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eventbus_prod
