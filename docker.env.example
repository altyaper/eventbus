# Copy to .env (docker compose reads .env automatically) and fill in
# before running `docker compose up`.

# Must be 64+ bytes. Generate with: openssl rand -base64 64 | tr -d "\n"
# (or mix phx.gen.secret)
SECRET_KEY_BASE=

# Hostname/IP you'll reach the app at on your LAN (e.g. raspberrypi.local or 192.168.1.50)
PHX_HOST=raspberrypi.local

# Optional: other hosts you open the UI at, comma-separated
# (e.g. eventbus.example.com,192.168.1.50). Live updates fail on any host not
# listed here, in PHX_HOST, or added by the superadmin at /settings (the place
# for browser apps that use /socket, e.g. https://changologs.com).
PHX_EXTRA_ORIGINS=

# Optional key for the first-run /setup screen (publishing uses per-application
# credentials). Leave empty to have one generated on first boot; it is printed
# in the logs (docker compose logs app) until setup is done.
EVENTBUS_API_KEY=

# Optional: send account emails (confirmation, password reset) through Resend
# (https://resend.com). Without a key they are only written to the logs.
# MAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=eventbus <noreply@example.com>

# Only when upgrading an install created before email accounts: the existing
# superadmin's email. The upgrade migration refuses to run without it.
EVENTBUS_ADMIN_EMAIL=

POSTGRES_USER=eventbus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eventbus_prod
